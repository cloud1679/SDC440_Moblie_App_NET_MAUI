<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Web_Serice_Authentication_and_Storage_App.ViewModels"
             xmlns:models="clr-namespace:Web_Serice_Authentication_and_Storage_App.Models"
             x:Class="Web_Serice_Authentication_and_Storage_App.Views.DataEntryPage"
             x:DataType="vm:DataEntryViewModel" Title="Data Entry">
    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="20">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="10" Padding="0,0,0,16">
                <Label Text="{Binding StudentName}" FontSize="30" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Please provide the following information:" FontSize="18" />
                <Label Text="Item ID" />
                <Entry Text="{Binding ItemId}" Placeholder="Item ID" SemanticProperties.Description="Item ID" IsEnabled="{Binding IsNotBusy}" />
                <Label Text="Item Name" />
                <Entry Text="{Binding ItemName}" Placeholder="Item Name" SemanticProperties.Description="Item Name" IsEnabled="{Binding IsNotBusy}" />
                <Label Text="Item Description" />
                <Entry Text="{Binding ItemDescription}" Placeholder="Item Description" SemanticProperties.Description="Item Description" IsEnabled="{Binding IsNotBusy}" />
                <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Label Text="{Binding Message}" AutomationId="DataMessage" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Stored items" FontSize="22" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                    <Button Grid.Column="1" Text="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" />
                </Grid>
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.EmptyView><Label Text="No items to display. Add an item using the fields above." Padding="0,12" /></CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:StoredItem">
                <Border Padding="14" Margin="0,4" Stroke="#888888" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ItemId, StringFormat='Item ID: {0}'}" FontSize="14" />
                        <Label Text="{Binding ItemName}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Binding ItemDescription}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
