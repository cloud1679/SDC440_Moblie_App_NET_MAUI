<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Web_Serice_Authentication_and_Storage_App.ViewModels"
             x:Class="Web_Serice_Authentication_and_Storage_App.MainPage"
             x:DataType="vm:LoginViewModel" Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="560">
            <Label Text="{Binding StudentName}" FontSize="30" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Wk 4 Performance Assessment" FontSize="20" />
            <Label Text="User Name" />
            <Entry Text="{Binding UserName}" Placeholder="User Name" IsEnabled="{Binding IsNotBusy}"
                   SemanticProperties.Description="User Name" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
            <Label Text="Password" />
            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" IsEnabled="{Binding IsNotBusy}"
                   SemanticProperties.Description="Password" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding IsNotBusy}">
                <Button Text="Login" Command="{Binding LoginCommand}" />
                <Button Grid.Column="1" Text="Cancel" Command="{Binding CancelCommand}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Message}" AutomationId="LoginMessage" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
