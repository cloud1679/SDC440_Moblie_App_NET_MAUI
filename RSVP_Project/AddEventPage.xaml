<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Project.AddEventPage"
             Title="Add Event">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Add New Event"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label Text="Host Name"/>
            <Entry
                x:Name="txtHostName"
                Placeholder="Enter host name"/>

            <Label Text="Event Name"/>
            <Entry
                x:Name="txtEventName"
                Placeholder="Enter event name"/>

            <Label Text="Event Address"/>
            <Entry
                x:Name="txtAddress"
                Placeholder="Enter event address"/>

            <Label Text="Maximum Number of Attendees"/>
            <Entry
                x:Name="txtMaxAttendees"
                Placeholder="Enter maximum attendees"
                Keyboard="Numeric"/>

            <Label Text="Event Date"/>
            <DatePicker
                x:Name="dateEvent"/>

            <Label Text="Event Time"/>
            <TimePicker
                x:Name="timeEvent"/>

            <Label Text="RSVP Deadline"/>
            <DatePicker
                x:Name="dateDeadline"/>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Text="Save Event"
                    Grid.Column="0"
                    Clicked="OnSaveClicked"/>

                <Button
                    Text="Cancel"
                    Grid.Column="1"
                    Clicked="OnCancelClicked"/>

            </Grid>

            <Label
                x:Name="lblMessage"
                FontSize="16"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>