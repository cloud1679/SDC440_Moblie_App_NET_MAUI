<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Project.RSVPPage"
             Title="RSVP">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="RSVP for Event"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label
                x:Name="lblEventName"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label Text="Name"/>
            <Entry
                x:Name="txtName"
                Placeholder="Enter your name"/>

            <Label Text="Email Address"/>
            <Entry
                x:Name="txtEmail"
                Placeholder="Enter your email"
                Keyboard="Email"/>

            <Label Text="Mobile Phone Number"/>
            <Entry
                x:Name="txtPhone"
                Placeholder="Enter your phone number"
                Keyboard="Telephone"/>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Text="RSVP"
                    Grid.Column="0"
                    Clicked="OnRSVPClicked"/>

                <Button
                    Text="Cancel"
                    Grid.Column="1"
                    Clicked="OnCancelClicked"/>

            </Grid>

            <Label
                x:Name="lblMessage"
                FontSize="16"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>