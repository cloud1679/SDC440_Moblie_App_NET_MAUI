<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Passing_Data_Between_Pages.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Richard Burns - Add and Subtract"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                HorizontalOptions="Center"/>

            <Label
                Text="First Value"/>

            <Entry
                x:Name="txtFirstValue"
                Placeholder="Enter first value"
                Keyboard="Numeric"/>

            <Label
                Text="Second Value"/>

            <Entry
                x:Name="txtSecondValue"
                Placeholder="Enter second value"
                Keyboard="Numeric"/>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Text="Addition"
                    Grid.Column="0"
                    Clicked="OnAdditionClicked"/>

                <Button
                    Text="Subtraction"
                    Grid.Column="1"
                    Clicked="OnSubtractionClicked"/>

            </Grid>

            <Label
                x:Name="lblMessage"
                FontSize="Large"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>